# claude-brainlab — environment template
# Copy this file to .env and fill in your values, then run: bash install/setup.sh
# .env is git-ignored.
#
# IMPORTANT: quote any value that contains spaces (paths!), e.g.
#   OBSIDIAN_VAULT="/Users/me/Library/Mobile Documents/.../my-vault"

# ─── Obsidian vault ───────────────────────────────────────────────
# The vault IS the lab tree. Since 16-10-2026 every repository of the base is cloned
# under one root, and Obsidian opens that root: a note lives inside the work it belongs
# to (`<area>/<theme>/<work>/notes/`), so there is no mapping between a project and a
# vault folder any more.
VAULT_NAME="brainlab"

# Full absolute path to the vault root.
# Lab tree (this is what the toolkit assumes):
#   "$HOME/brainlab"
# A separate vault, if you keep notes away from the code:
#   "$HOME/Obsidian/$VAULT_NAME"
OBSIDIAN_VAULT="$HOME/brainlab"

# ─── Project roots (filesystem) ───────────────────────────────────
# Where your research projects live on disk. Inside the lab tree a work is its own
# folder, so these roots matter only if you keep code away from the tree.
PAPERS_ROOT="$HOME/Papers"
PROJECTS_ROOT="$HOME/Projects"
STAFF_ROOT="$HOME/Staff"

# ─── Python interpreter ───────────────────────────────────────────
# Used by hooks and helper scripts. Use absolute path if you have a
# specific Python (conda/uv/system).
PYTHON_BIN="python3"

# ─── OpenRouter (needed by the recording hook) ─────────────────────
# The Stop hook asks a cheap model whether the turn produced something the
# laboratory should keep, and where it belongs. Without a key the hook loads,
# gives up on every turn and records nothing, so it looks switched off.
# setup.sh writes it to ~/.config/brainlab/openrouter-key (chmod 600) and never
# into settings.json. Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# ─── Zotero (optional, only needed for paper-ingest / want-2-read) ─
# Get API key at: https://www.zotero.org/settings/keys
# Find LIBRARY_ID at: https://www.zotero.org/<username> (numeric ID in URL)
ZOTERO_API_KEY=""
ZOTERO_LIBRARY_ID=""
UNPAYWALL_EMAIL="you@example.com"

# ─── Plane MCP (optional) ─────────────────────────────────────────
# Official local stdio server. Requires uv/uvx on the client machine.
# PLANE_BASE_URL defaults to Plane Cloud; use your API URL when self-hosting.
PLANE_API_KEY=""
PLANE_WORKSPACE_SLUG=""
PLANE_BASE_URL="https://api.plane.so"

# ─── User identity (used in some hooks/skills) ────────────────────
USER_EMAIL="you@example.com"
