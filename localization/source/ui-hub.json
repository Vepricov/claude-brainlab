      ]
    },
    {
      "id": "e0cd22932fe3",
      "text": "Работа",
      "paths": [
        "hub.js:21"
      ]
    },
    {
      "id": "c9832c88ccd5",
      "text": "Один исследовательский вопрос и всё, что о нём известно: идеи, прогоны, рукопись, код.",
      "paths": [
        "hub.js:21"
      ]
    },
    {
      "id": "26e0d0731013",
      "text": "Утверждение",
      "paths": [
        "hub.js:22"
      ]
    },
    {
      "id": "3949dbfebe11",
      "text": "Проверяемая мысль и условие, при котором мы признаем её ложной. Условие пишется до проверки.",
      "paths": [
        "hub.js:22"
      ]
    },
    {
      "id": "564307b4056f",
      "text": "Прогон",
      "paths": [
        "hub.js:23"
      ]
    },
    {
      "id": "1ab695e1c011",
      "text": "Его страницу пишет сам код обучения: гиперпараметры, метрики, коммит, железо.",
      "paths": [
        "hub.js:23"
      ]
    },
    {
      "id": "c89eba90f1d8",
      "text": "Предложение",
      "paths": [
        "hub.js:24"
      ]
    },
    {
      "id": "1836af9e6bb2",
      "text": "Новое знание входит веткой и предложением. Предлагают и люди, и агенты.",
      "paths": [
        "hub.js:24"
      ]
    },
    {
      "id": "bb1b79b14c91",
      "text": "Проверки",
      "paths": [
        "hub.js:25"
      ]
    },
    {
      "id": "11313098201b",
      "text": "Код сверяет каждое число с прогонами, модель-судья читает текст.",
      "paths": [
        "hub.js:25"
      ]
    },
    {
      "id": "83c3e643a7f0",
      "text": "Слияние ведущим",
      "paths": [
        "hub.js:26"
      ]
    },
    {
      "id": "53df69f98409",
      "text": "Знанием становится только то, что принял человек, ведущий работы.",
      "paths": [
        "hub.js:26"
      ]
    },
    {
      "id": "1417b7792d57",
      "text": "История",
      "paths": [
        "hub.js:27"
      ]
    },
    {
      "id": "d14de177f370",
      "text": "У каждого числа в статье есть адрес и автор. Опровергнутое не удаляется.",
      "paths": [
        "hub.js:27"
      ]
    },
    {
      "id": "ba8d82b3b889",
      "text": "Вся лаборатория на машине одним деревом, и его же открывает Obsidian.",
      "paths": [
        "hub.js:28"
      ]
    },
    {
      "id": "f6bdcefe4c15",
      "text": "Харнесс для всей команды",
      "paths": [
        "hub.js:30"
      ]
    },
    {
      "id": "98736f46d025",
      "text": "База знаний, которая проверяет себя",
      "paths": [
        "hub.js:30"
      ]
    },
    {
      "id": "bfa7854e5e5d",
      "text": "Автономный ресёрч 24/7",
      "paths": [
        "hub.js:30"
      ]
    },
    {
      "id": "60e39095f62b",
      "text": "Ноль выдуманных чисел",
      "paths": [
        "hub.js:31"
      ]
    },
    {
      "id": "7b6e678b6cca",
      "text": "Люди и агенты в одном git",
      "paths": [
        "hub.js:31"
      ]
    },
