#!/usr/bin/env python3
"""База знания лаборатории в GitLab как обычный git.

Единица в GitLab — работа: у неё свой проект, свои члены, своя доска и свои задачи. Тема
стала группой, направление — группой над ней. Поэтому клонируется работа, а не тема, и
полный путь искать не нужно: скажи слаг работы, остальное найдётся само.

Здесь только то, чего git не делает сам: открыть предложение о слиянии и показать, что
сказали проверки. Всё остальное — `git pull`, `git checkout -b`, правка файлов, `git push`
— обычный git, и прослойки для этого не нужно.

    lab here <работа>      склонировать работу В ПАПКУ ПРОЕКТА (lab-base) или обновить
    lab clone [работа…]    склонировать в общую папку (для машины без проектов)
    lab pull               обновить работу текущего каталога и показать, что изменилось
    lab pr ["заголовок"]   запушить ветку, открыть предложение, показать вердикт
      --задача <номер>     вписать `Closes #<номер>`: слияние закроет задачу само
    lab checks             что сказали проверки и что написано в обсуждении
    lab tasks              открытые задачи работы: кому назначены, какое утверждение
    lab take <номер>       взять задачу на себя: исполнитель и ярлык «делается»
    lab open               напечатать адрес работы или своего предложения

База переключена на GitLab 01-10-2026: прежний помощник для Gitea удалён.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

BASE = Path(os.getenv("LAB_BASE_DIR", "~/brainlab-stack/git-base")).expanduser()
URL_FILE = Path("~/.config/brainlab/git-url").expanduser()
TOKEN_FILE = Path(os.getenv("LAB_GIT_TOKEN_FILE", "~/.config/brainlab/git-token")).expanduser()
LOGIN_FILE = Path("~/.config/brainlab/git-login").expanduser()
#: Логин человека в GitLab, одной строкой. Кладётся руками один раз: он приходит в письме
#: бота вместе с доступом. Нужен, чтобы `lab take` знал, на кого назначать задачу.
МОЙ_ЛОГИН = Path("~/.config/brainlab/gitlab-login").expanduser()
CREDENTIALS = Path("~/.config/brainlab/git-credentials").expanduser()
#: Личный ключ GitLab принимает с любым именем пользователя; ключ группы — только со своим
#: именем. Поэтому логин спрашивается, но по умолчанию его знать не надо.
ЛОГИН_ПО_УМОЛЧАНИЮ = "oauth2"


def запомнить(файл: Path, значение: str) -> str:
    """Сохранить сказанное один раз, чтобы не передавать каждый запуск. Права 600."""
    файл.parent.mkdir(parents=True, exist_ok=True)
    if not файл.is_file() or файл.read_text(encoding="utf-8").strip() != значение:
        файл.write_text(значение + "\n", encoding="utf-8")
    файл.chmod(0o600)
    return значение


def сайт() -> str:
    """Адрес базы. Из окружения, иначе из файла, иначе внятный отказ.

    В коде его нет нарочно: этот репозиторий открытый, а база — нет. Адрес приходит в
    сообщении бота доступа, и первый запуск запоминает его в файле.
    """
    сказано = (os.getenv("LAB_GIT_URL") or "").strip().rstrip("/")
    if сказано:
        return запомнить(URL_FILE, сказано)
    if URL_FILE.is_file():
        запомнено = URL_FILE.read_text(encoding="utf-8").strip().rstrip("/")
        if запомнено:
            return запомнено
    sys.exit("не знаю адреса базы: он приходит в сообщении бота доступа.\n"
             "Скажи его один раз: export LAB_GIT_URL=https://…")


def token() -> str:
    сказано = (os.getenv("LAB_GIT_TOKEN") or "").strip()
    if сказано:
        return запомнить(TOKEN_FILE, сказано)
    if TOKEN_FILE.is_file():
        return TOKEN_FILE.read_text(encoding="utf-8").strip()
    sys.exit("не знаю ключа для git: он приходит в сообщении бота доступа.\n"
             "Скажи его один раз: export LAB_GIT_TOKEN=…")


def логин() -> str:
    сказано = (os.getenv("LAB_GIT_LOGIN") or "").strip()
    if сказано:
        return запомнить(LOGIN_FILE, сказано)
    if LOGIN_FILE.is_file():
        return LOGIN_FILE.read_text(encoding="utf-8").strip()
    return ЛОГИН_ПО_УМОЛЧАНИЮ


def api(path: str, *, method: str = "GET", payload: dict | None = None,
        молча: bool = False):
    body = json.dumps(payload).encode("utf-8") if payload is not None else None
    адрес = urllib.parse.quote(path, safe="/?&=%#:+,.~*!$'()[]@-_")
    request = urllib.request.Request(
        f"{сайт()}/api/v4/{адрес}", data=body, method=method,
        headers={"PRIVATE-TOKEN": token(), "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=60) as answer:
            text = answer.read().decode("utf-8")
    except urllib.error.HTTPError as беда:
        if молча:
            return None
        sys.exit(f"GitLab ответил {беда.code}: "
                 f"{беда.read().decode('utf-8', 'replace')[:300]}")
    return json.loads(text) if text.strip() else None


def ид(путь: str) -> str:
    return urllib.parse.quote(путь, safe="")


#: Переменные, которыми git перебивает каталог. Если они остались от чужой работы — а у
#: агентов это бывает, внутренние репозитории держат именно так, — то `cwd` перестаёт
#: значить что-либо, и `lab` начинает ходить по чужому репозиторию.
СВОЙ_GIT = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE")


def окружение() -> dict[str, str]:
    среда = dict(os.environ)
    for имя in СВОЙ_GIT:
        среда.pop(имя, None)
    return среда


def git(*args: str, cwd: Path | None = None, quiet: bool = False) -> str:
    итог = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True,
                          env=окружение())
    if итог.returncode and not quiet:
        sys.exit(итог.stderr.strip() or f"git {' '.join(args)} не вышел")
    return итог.stdout.strip()


def настроить_ключ() -> None:
    """Отдать ключ git'у его же способом, а не писать файл руками.

    Файл хранилища git пишет сам и в своём виде: порт в нём закодирован (`host%3a9445`).
    Строка, написанная руками в очевидном виде, не совпадает с тем, что git ищет, и
    первый же `clone` отвечает «Access denied» при верном ключе. Проверено при
    переключении на GitLab.
    """
    CREDENTIALS.parent.mkdir(parents=True, exist_ok=True)
    CREDENTIALS.touch(mode=0o600, exist_ok=True)
    CREDENTIALS.chmod(0o600)
    помощники = git("config", "--global", "--get-all", "credential.helper", quiet=True)
    if str(CREDENTIALS) not in помощники:
        git("config", "--global", "--add", "credential.helper",
            f"store --file={CREDENTIALS}")
    без_схемы = сайт().split("://", 1)[-1]
    схема = сайт().split("://", 1)[0] if "://" in сайт() else "https"
    запрос = (f"protocol={схема}\nhost={без_схемы}\n"
              f"username={логин()}\npassword={token()}\n\n")
    subprocess.run(["git", "credential", "approve"], input=запрос, text=True,
                   capture_output=True, env=окружение())


def найти(слаг: str) -> dict:
    """Проект работы по её слагу. Полный путь знать не надо, он ищется."""
    похожие = api(f"projects?search={слаг}&simple=true&per_page=100") or []
    точные = [п for п in похожие if п["path"] == слаг]
    if not точные:
        # «Не видно» у работы почти всегда значит «нет доступа», а не «нет такой»: работы
        # закрыты, и у не-участника они не отличаются от несуществующих. Сказать это надо
        # прямо, иначе первая же команда из инструкции выглядит как поломка базы.
        подсказка = ", ".join(sorted(п["path"] for п in похожие)[:8])
        sys.exit(f"работы {слаг} не видно. Либо такой нет, либо у тебя нет к ней доступа: "
                 "работы закрыты, и доступ даётся на тему — кнопка Request access на "
                 "странице темы, решает её ведущий."
                 + (f"\nРядом видно: {подсказка}" if подсказка else ""))
    if len(точные) > 1:
        пути = ", ".join(п["path_with_namespace"] for п in точные)
        sys.exit(f"таких несколько, скажи полный путь: {пути}")
    return точные[0]


def работы() -> list[dict]:
    """Все работы, какие видно. Литература и передние страницы групп — не работы."""
    найдено = api("projects?simple=true&per_page=100&archived=false") or []
    return sorted((п for п in найдено
                   if п["path"] not in ("literature", "gitlab-profile")),
                  key=lambda п: п["path_with_namespace"])


def здесь() -> tuple[dict, Path]:
    """Работа и корень клона. Слаг берётся из адреса origin, а не из имени каталога."""
    корень = git("rev-parse", "--show-toplevel", quiet=True)
    if not корень:
        sys.exit(f"это не клон работы: {Path.cwd()}")
    путь = Path(корень)
    адрес = git("config", "--get", "remote.origin.url", cwd=путь, quiet=True)
    слаг = (адрес.rstrip("/").rsplit("/", 1)[-1].removesuffix(".git")
            if адрес else путь.name)
    return найти(слаг), путь


def корень_проекта(откуда: Path | None = None) -> Path:
    """Папка проекта: где лежит `.lab-work`, иначе текущая."""
    это = (откуда or Path.cwd()).resolve()
    for папка in (это, *это.parents):
        if (папка / ".lab-work").is_file():
            return папка
        if папка == папка.parent:
            break
    return это


def адрес_клона(проект: dict) -> str:
    """Адрес для git. Берётся у GitLab, но хостом с той стороны, куда мы ходим сами."""
    свой = проект.get("http_url_to_repo") or ""
    if not свой:
        return f"{сайт()}/{проект['path_with_namespace']}.git"
    путь = свой.split("://", 1)[-1].split("/", 1)[-1]
    return f"{сайт()}/{путь}"


def обновить(куда: Path) -> tuple[str, str]:
    было = git("rev-parse", "HEAD", cwd=куда, quiet=True)
    git("fetch", "-q", "origin", cwd=куда)
    subprocess.run(["git", "pull", "-q", "--ff-only", "origin", "main"],
                   cwd=куда, capture_output=True, text=True, env=окружение())
    return было, git("rev-parse", "HEAD", cwd=куда, quiet=True)


#: Кем подписывается то, что написал агент. Имя не косметика: по нему в истории и во
#: вкладке активности видно, кто что сделал. 02-10-2026 выяснилось, что семь коммитов
#: подписаны именем и почтой владельца, хотя писал их агент, — и разобрать, кто автор,
#: стало нельзя. Личный `git config` человека для клона базы не годится по той же причине.
АГЕНТ = ("lab-agent", "agent@brainlab-ai.com")


def подписать_клон(куда: Path) -> None:
    """Поставить клону имя автора, чтобы его не приходилось помнить каждый раз."""
    имя, почта = АГЕНТ
    git("config", "user.name", имя, cwd=куда, quiet=True)
    git("config", "user.email", почта, cwd=куда, quiet=True)


def do_here(имена: list[str]) -> None:
    """Склонировать работу в папку проекта, а если клон уже есть — обновить его."""
    if not имена:
        sys.exit("скажи работу: lab here <работа>")
    настроить_ключ()
    проект = найти(имена[0])
    куда = корень_проекта() / "lab-base"
    адрес = адрес_клона(проект)
    if not (куда / ".git").is_dir():
        git("clone", "-q", адрес, str(куда))
        подписать_клон(куда)
        print(f"работа склонирована: {куда}")
        return
    подписать_клон(куда)
    было_адрес = git("config", "--get", "remote.origin.url", cwd=куда, quiet=True)
    if было_адрес != адрес:
        # Клон из чужого локального клона выглядит рабочим, а push уходит в никуда.
        действие = "set-url" if было_адрес else "add"
        git("remote", действие, "origin", адрес, cwd=куда, quiet=True)
        print(f"адрес origin исправлен на {адрес}")
    было, стало = обновить(куда)
    if было == стало:
        print(f"работа на месте и без изменений: {куда}")
    else:
        print(f"работа обновлена: {куда}")
        print(git("--no-pager", "diff", "--stat", f"{было}..{стало}", cwd=куда))


def do_clone(имена: list[str]) -> None:
    настроить_ключ()
    BASE.mkdir(parents=True, exist_ok=True)
    выбор = [найти(и) for и in имена] if имена else работы()
    for проект in выбор:
        куда = BASE / проект["path"]
        print(f"{проект['path']:34}", end=" ", flush=True)
        if (куда / ".git").is_dir():
            git("fetch", "-q", "origin", cwd=куда)
            итог = subprocess.run(["git", "pull", "-q", "--ff-only", "origin", "main"],
                                  cwd=куда, capture_output=True, text=True,
                                  env=окружение())
            print("обновлено" if итог.returncode == 0 else "есть свои правки, не трогаю")
        else:
            git("clone", "-q", адрес_клона(проект), str(куда))
            print("склонировано")
        подписать_клон(куда)
    print(f"\nБаза лежит в {BASE}. Дальше это обычный git.")


def моё_предложение(проект: dict, ветка: str) -> dict | None:
    открытые = api(f"projects/{проект['id']}/merge_requests?state=opened&per_page=100") or []
    for мр in открытые:
        if мр.get("source_branch") == ветка:
            return мр
    return None


def do_pull() -> None:
    проект, корень = здесь()
    было, стало = обновить(корень)
    if было == стало:
        print(f"{проект['path']}: без изменений")
    else:
        print(f"{проект['path']}: изменилось с прошлого раза")
        print(git("--no-pager", "diff", "--stat", f"{было}..{стало}", cwd=корень))
    открытые = api(f"projects/{проект['id']}/merge_requests?state=opened&per_page=100") or []
    if открытые:
        print("открытые предложения этой работы:")
        for мр in открытые:
            print(f"  !{мр['iid']}  {мр.get('source_branch','')}  {мр.get('title','')[:60]}")


def do_pr(аргументы: list[str]) -> None:
    # `--задача N` вписывает в предложение `Closes #N`. Это не украшение: GitLab закрывает
    # задачу при слиянии сам, и тогда доска не врёт — сделанное уходит с неё без ручного
    # шага, а в задаче остаётся ссылка на то предложение, которым она закрыта.
    задача = ""
    остаток = []
    пока = list(аргументы)
    while пока:
        это = пока.pop(0)
        if это in ("--задача", "--task"):
            задача = (пока.pop(0) if пока else "").lstrip("#")
        elif это.startswith("--задача="):
            задача = это.split("=", 1)[1].lstrip("#")
        else:
            остаток.append(это)
    аргументы = остаток
    проект, корень = здесь()
    ветка = git("rev-parse", "--abbrev-ref", "HEAD", cwd=корень)
    if ветка == "main":
        sys.exit("ты на main: сделай ветку, например git checkout -b claim/H-WSD-001")
    настроить_ключ()
    git("push", "-q", "-u", "origin", ветка, cwd=корень)
    если_есть = моё_предложение(проект, ветка)
    if если_есть:
        print(f"предложение уже открыто: !{если_есть['iid']}  {если_есть['web_url']}")
        print("твой push в него вошёл\n")
        номер = int(если_есть["iid"])
        if задача and f"Closes #{задача}" not in (если_есть.get("description") or ""):
            api(f"projects/{проект['id']}/merge_requests/{номер}", method="PUT", payload={
                "description": (если_есть.get("description") or "").rstrip()
                               + f"\n\nCloses #{задача}"})
            print(f"дописал в предложение `Closes #{задача}`\n")
    else:
        заголовок = (аргументы[0] if аргументы
                     else git("log", "-1", "--pretty=%s", cwd=корень))
        тело = (аргументы[1] if len(аргументы) > 1
                else git("log", "-1", "--pretty=%b", cwd=корень))
        if задача:
            тело = f"{тело}\n\nCloses #{задача}".strip()
        открыт = api(f"projects/{проект['id']}/merge_requests", method="POST", payload={
            "source_branch": ветка, "target_branch": "main", "title": заголовок,
            "description": тело or заголовок, "remove_source_branch": True})
        print(f"открыто предложение !{открыт['iid']}  {открыт['web_url']}\n")
        номер = int(открыт["iid"])
    print("== проверки")
    показать_проверки(проект, номер, git("rev-parse", "HEAD", cwd=корень), ждать=100)


def показать_проверки(проект: dict, номер: int, sha: str, *, ждать: int = 0) -> None:
    """Вердикт проверок и последнее слово обсуждения.

    Проверки ставит отдельная служба, и ходит она раз в минуту. Сразу после push статуса
    ещё нет, и «проверок нет» читается как «всё хорошо» — худшее из возможных сообщений.
    Поэтому здесь ждём появления вердикта, а не сообщаем пустоту.
    """
    предел = time.monotonic() + ждать
    статусы: list = []
    while True:
        статусы = api(f"projects/{проект['id']}/repository/commits/{sha}/statuses") or []
        живые = [с for с in статусы if с.get("status") not in ("pending", "running")]
        if живые or time.monotonic() >= предел:
            статусы = живые or статусы
            break
        print("  ждём проверок…", flush=True)
        time.sleep(6)
    if not статусы:
        print("  проверки ещё не проставлены — повтори `lab checks` через минуту")
    for статус in статусы:
        знак = {"success": "зелено", "failed": "есть замечания", "failure": "есть замечания",
                "canceled": "отменена", "running": "идёт", "pending": "идёт"}.get(
                    статус.get("status", ""), статус.get("status", ""))
        print(f"  {статус.get('name') or статус.get('context','')}: {знак}"
              f" — {статус.get('description','')}")
    зелено = bool(статусы) and all(с.get("status") == "success" for с in статусы)
    отзывы = api(f"projects/{проект['id']}/merge_requests/{номер}/notes"
                 f"?per_page=20&sort=asc") or []
    разборы = [о for о in отзывы if "Проверка базы" in (о.get("body") or "")]
    if зелено:
        # Разбор служба пишет только когда есть что сказать. Значит при зелёном статусе
        # самый свежий разбор — прошлый, и печатать его значит показывать снятые
        # замечания как действующие.
        if разборы:
            print("  прежние замечания снялись")
    elif разборы:
        print("\n== что сказала проверка")
        print((разборы[-1].get("body") or "").strip()[:1500])
    прочие = [о for о in отзывы if о not in разборы and not о.get("system")][-3:]
    if прочие:
        print("\n== обсуждение")
        for отзыв in прочие:
            кто = (отзыв.get("author") or {}).get("username", "?")
            print(f"  [{кто}] {(отзыв.get('body') or '').strip()[:300]}")


def do_checks() -> None:
    проект, корень = здесь()
    ветка = git("rev-parse", "--abbrev-ref", "HEAD", cwd=корень)
    если_есть = моё_предложение(проект, ветка)
    if если_есть is None:
        sys.exit(f"по ветке {ветка} открытого предложения нет — сделай lab pr")
    print(f"предложение !{если_есть['iid']}  {если_есть['web_url']}\n")
    print("== проверки")
    показать_проверки(проект, int(если_есть["iid"]),
                      git("rev-parse", "HEAD", cwd=корень))


def мой_логин() -> str:
    try:
        return МОЙ_ЛОГИН.read_text(encoding="utf-8").strip().splitlines()[0].strip()
    except (OSError, IndexError):
        return ""


def утверждение_задачи(тело: str) -> str:
    """Код утверждения, на которое влияет задача. Строка «Утверждение: H-XXX-001» в теле."""
    если = re.search(r"^\s*(?:\*\*)?Утверждение:?(?:\*\*)?\s*([HDSEF]-[A-Z]{2,4}-\d+)",
                     тело or "", re.M)
    return если.group(1) if если else ""


def do_tasks() -> None:
    """Задачи работы: кому назначена, что за ход дела, какое утверждение затрагивает."""
    проект, _ = здесь()
    задачи = api(f"projects/{проект['id']}/issues?state=opened&per_page=100") or []
    if not задачи:
        print(f"{проект['path']}: открытых задач нет")
        return
    я = мой_логин()
    print(f"{проект['path']}: открытых задач {len(задачи)}")
    for з in задачи:
        ярлыки = ", ".join(з.get("labels") or [])
        кто = ", ".join(и["username"] for и in (з.get("assignees") or []))
        метка = "ТЕБЕ" if (я and я in кто.split(", ")) else (кто or "—")
        код = утверждение_задачи(з.get("description") or "")
        срок = f" до {з['due_date']}" if з.get("due_date") else ""
        print(f"  #{з['iid']:<4} [{ярлыки}] {з['title'][:74]}{срок}")
        print(f"        {метка}{('  → ' + код) if код else ''}")
    print(f"\nдоска: {проект['web_url']}/-/boards")
    print("взять задачу: `lab take <номер>`; отвечать на неё — "
          "`lab pr --задача <номер>`")


def do_take(аргументы: list[str]) -> None:
    """Взять задачу: поставить себя исполнителем и ярлык «делается».

    Без этого шага двое берутся за одно: доска показывает задачу свободной, пока на ней
    никого нет. Ярлык и исполнитель ставятся одним вызовом, чтобы не остаться на половине.
    """
    if not аргументы:
        sys.exit("нужен номер задачи: lab take 7")
    номер = аргументы[0].lstrip("#")
    проект, _ = здесь()
    задача = api(f"projects/{проект['id']}/issues/{номер}")
    if задача is None:
        sys.exit(f"задачи #{номер} в работе {проект['path']} нет")
    данные: dict = {"add_labels": "делается"}
    я = мой_логин()
    if я:
        нашлись = api(f"users?username={urllib.parse.quote(я)}") or []
        if нашлись:
            данные["assignee_ids"] = [нашлись[0]["id"]]
        else:
            print(f"учётной записи «{я}» в GitLab не нашлось: ставлю только ярлык")
    else:
        print(f"кто ты — неизвестно: положи свой логин GitLab в {МОЙ_ЛОГИН}")
    стало = api(f"projects/{проект['id']}/issues/{номер}", method="PUT", payload=данные)
    кто = ", ".join(и["username"] for и in (стало.get("assignees") or [])) or "никому"
    print(f"#{номер} {стало['title'][:70]}")
    print(f"  ярлыки: {', '.join(стало.get('labels') or [])} | на {кто}")
    код = утверждение_задачи(стало.get("description") or "")
    if код:
        print(f"  задача про утверждение {код}: ветка `claim/{код}`, "
              f"запись идёт под него")
    print(f"  когда сделаешь: `lab pr --задача {номер}` — слияние закроет задачу само")


def main() -> None:
    что = sys.argv[1] if len(sys.argv) > 1 else ""
    хвост = sys.argv[2:]
    if что == "clone":
        do_clone(хвост)
    elif что == "here":
        do_here(хвост)
    elif что == "pull":
        do_pull()
    elif что == "pr":
        do_pr(хвост)
    elif что == "checks":
        do_checks()
    elif что == "tasks":
        do_tasks()
    elif что == "take":
        do_take(хвост)
    elif что == "open":
        проект, _ = здесь()
        print(проект["web_url"])
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
